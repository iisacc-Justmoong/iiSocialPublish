if(NOT SOURCE_ROOT OR NOT BUILD_ROOT)
    message(FATAL_ERROR "Both project roots are required")
endif()
foreach(name fixtures tls-loopback review-fixture.png)
    if(EXISTS "${BUILD_ROOT}/${name}")
        message(FATAL_ERROR "Test resource leaked into the build directory: ${name}")
    endif()
endforeach()
foreach(name "canvas export.bin" "canvas large.bin" review-fixture.png certificate.pem key.pem)
    if(NOT EXISTS "${SOURCE_ROOT}/resources/test-fixtures/${name}")
        message(FATAL_ERROR "Missing test resource: ${name}")
    endif()
endforeach()
file(SIZE "${SOURCE_ROOT}/resources/test-fixtures/canvas large.bin" size)
if(NOT size EQUAL 4194312)
    message(FATAL_ERROR "Incorrect large upload fixture size")
endif()
