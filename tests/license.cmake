if(NOT SOURCE_ROOT OR NOT INTEGRATION_CONFIG OR NOT PUBLISH_CONFIG)
    message(FATAL_ERROR "SOURCE_ROOT, INTEGRATION_CONFIG, and PUBLISH_CONFIG are required")
endif()
file(READ "${SOURCE_ROOT}/LICENSE" license)
if(NOT license MATCHES "Apache License" OR NOT license MATCHES "Version 2.0, January 2004")
    message(FATAL_ERROR "LICENSE is not the Apache License, Version 2.0")
endif()
if(license MATCHES "Permission is hereby granted")
    message(FATAL_ERROR "LICENSE still contains the MIT permission grant")
endif()
file(READ "${SOURCE_ROOT}/NOTICE" notice)
if(NOT notice MATCHES "Copyright \\(c\\) 2026 iisacc")
    message(FATAL_ERROR "NOTICE is missing Copyright (c) 2026 iisacc")
endif()
file(READ "${SOURCE_ROOT}/README.md" readme)
if(NOT readme MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "README license section does not identify Apache-2.0")
endif()
file(READ "${SOURCE_ROOT}/docs/License.md" korean)
if(NOT korean MATCHES "SPDX-License-Identifier: Apache-2.0")
    message(FATAL_ERROR "docs/License.md does not identify Apache-2.0")
endif()
foreach(config IN ITEMS "${INTEGRATION_CONFIG}" "${PUBLISH_CONFIG}")
    if(NOT EXISTS "${config}")
        message(FATAL_ERROR "Package config was not generated: ${config}")
    endif()
    file(READ "${config}" text)
    if(NOT text MATCHES "SPDX_LICENSE \"Apache-2.0\"")
        message(FATAL_ERROR "Package config does not export SPDX license Apache-2.0: ${config}")
    endif()
endforeach()
