@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(iiSocialIntegration @PROJECT_VERSION@ CONFIG)
set(iiSocialPublish_LICENSE_DIR "${iiSocialIntegration_LICENSE_DIR}")
if(NOT TARGET iiSocialPublish::iiSocialPublish)
    add_library(iiSocialPublish::iiSocialPublish INTERFACE IMPORTED)
    set_property(TARGET iiSocialPublish::iiSocialPublish PROPERTY INTERFACE_LINK_LIBRARIES iiSocialIntegration::iiSocialIntegration)
endif()
check_required_components(iiSocialPublish)
